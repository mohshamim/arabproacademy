generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  EDITOR
}

enum LeadType {
  CONTACT
  ENROLL
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  ENROLLED
  LOST
  ARCHIVED
}

enum LeadSource {
  WEBSITE
  WHATSAPP
  INSTAGRAM
  GOOGLE
  REFERRAL
  OTHER
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(EDITOR)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  assignedLeads Lead[]   @relation("LeadAssignee")
}

model Lead {
  id         String     @id @default(cuid())
  type       LeadType
  status     LeadStatus @default(NEW)
  source     LeadSource @default(WEBSITE)
  name       String?
  email      String?
  phone      String?
  interest   String?
  message    String?    @db.Text
  notes      String?    @db.Text
  assigneeId String?
  followUpAt DateTime?
  payload    Json?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  assignee   AdminUser? @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  students   Student[]

  @@index([type, status])
  @@index([createdAt])
  @@index([assigneeId])
  @@index([followUpAt])
  @@index([source])
}

enum CourseKind {
  IN_PERSON
  ONLINE
}

enum BatchMode {
  IN_PERSON
  ONLINE
  HYBRID
}

enum BatchStatus {
  UPCOMING
  RUNNING
  COMPLETED
}

enum StudentStatus {
  ACTIVE
  COMPLETED
  PAUSED
  DROPPED
}

model Course {
  id            String       @id @default(cuid())
  slug          String       @unique
  name          String
  kind          CourseKind
  description   String       @db.Text
  durationLabel String
  published     Boolean      @default(true)
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  weeks         CourseWeek[]
  batches       Batch[]
}

model CourseWeek {
  id          String  @id @default(cuid())
  courseId    String
  weekNumber  Int
  title       String
  outcomes    String  @db.Text
  vocabulary  String  @db.Text
  activity    String  @db.Text
  homework    String  @db.Text
  materialUrl String?
  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, weekNumber])
  @@index([courseId])
}

model Batch {
  id         String      @id @default(cuid())
  courseId   String
  name       String
  mode       BatchMode   @default(IN_PERSON)
  startDate  DateTime?
  endDate    DateTime?
  daysLabel  String      @default("")
  capacity   Int         @default(12)
  status     BatchStatus @default(UPCOMING)
  notes      String?     @db.Text
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  course     Course      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  students   Student[]

  @@index([courseId])
  @@index([status])
}

model Student {
  id          String         @id @default(cuid())
  name        String
  phone       String
  email       String?
  level       String?
  status      StudentStatus  @default(ACTIVE)
  paymentNote String?
  notes       String?        @db.Text
  leadId      String?
  batchId     String?
  enrolledAt  DateTime       @default(now())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  lead        Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  batch       Batch?         @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([batchId])
  @@index([leadId])
  @@index([status])
  @@index([phone])
}

model PricingPackage {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  price            String
  period           String
  description      String
  features         Json
  cta              String
  whatsappMessage  String   @db.Text
  popular          Boolean  @default(false)
  published        Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model OnlineLevel {
  id               String   @id @default(cuid())
  slug             String   @unique
  level            String
  name             String
  badgeColor       String   @default("teal")
  monthlyPrice     String
  fullPrice        String
  features         Json
  whatsappMessage  String   @db.Text
  published        Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String   @db.Text
  answer    String   @db.Text
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  initial   String
  text      String   @db.Text
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorEmail String
  actorId    String?
  action     String
  entityType String
  entityId   String?
  summary    String   @db.Text
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  ip        String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}
