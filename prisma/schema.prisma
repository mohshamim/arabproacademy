generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  EDITOR
}

enum LeadType {
  CONTACT
  ENROLL
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  ENROLLED
  LOST
  ARCHIVED
}

enum LeadSource {
  WEBSITE
  WHATSAPP
  INSTAGRAM
  GOOGLE
  REFERRAL
  OTHER
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(EDITOR)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  assignedLeads Lead[]   @relation("LeadAssignee")
}

model Lead {
  id         String     @id @default(cuid())
  type       LeadType
  status     LeadStatus @default(NEW)
  source     LeadSource @default(WEBSITE)
  name       String?
  email      String?
  phone      String?
  interest   String?
  message    String?    @db.Text
  notes      String?    @db.Text
  assigneeId String?
  followUpAt DateTime?
  payload    Json?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  assignee   AdminUser? @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  students   Student[]

  @@index([type, status])
  @@index([createdAt])
  @@index([assigneeId])
  @@index([followUpAt])
  @@index([source])
}

enum CourseKind {
  IN_PERSON
  ONLINE
}

enum BatchMode {
  IN_PERSON
  ONLINE
  HYBRID
}

enum BatchStatus {
  UPCOMING
  RUNNING
  COMPLETED
}

enum StudentStatus {
  ACTIVE
  COMPLETED
  PAUSED
  DROPPED
}

model Course {
  id            String       @id @default(cuid())
  slug          String       @unique
  name          String
  kind          CourseKind
  description   String       @db.Text
  durationLabel String
  published     Boolean      @default(true)
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  weeks         CourseWeek[]
  batches       Batch[]
  quizzes       Quiz[]
}

model CourseWeek {
  id            String             @id @default(cuid())
  courseId      String
  weekNumber    Int
  title         String
  outcomes      String             @db.Text
  vocabulary    String             @db.Text
  activity      String             @db.Text
  homework      String             @db.Text
  materialUrl   String?            @db.Text
  audioUrl      String?            @db.Text
  recordingUrl  String?            @db.Text
  course        Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  homeworkLogs  HomeworkEntry[]
  quizzes       Quiz[]

  @@unique([courseId, weekNumber])
  @@index([courseId])
}

model Batch {
  id         String      @id @default(cuid())
  courseId   String
  name       String
  mode       BatchMode   @default(IN_PERSON)
  startDate  DateTime?
  endDate    DateTime?
  daysLabel  String      @default("")
  capacity   Int         @default(12)
  status     BatchStatus @default(UPCOMING)
  notes      String?     @db.Text
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  course     Course         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  students   Student[]
  sessions   ClassSession[]
  oralExams  OralExam[]

  @@index([courseId])
  @@index([status])
}

model Student {
  id          String         @id @default(cuid())
  name        String
  phone       String
  email       String?
  level       String?
  status      StudentStatus  @default(ACTIVE)
  paymentNote String?
  notes       String?        @db.Text
  leadId      String?
  batchId     String?
  enrolledAt  DateTime       @default(now())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  lead        Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  batch       Batch?          @relation(fields: [batchId], references: [id], onDelete: SetNull)
  attendance  Attendance[]
  attempts    QuizAttempt[]
  examResults OralExamResult[]
  homework    HomeworkEntry[]
  certificates Certificate[]

  @@index([batchId])
  @@index([leadId])
  @@index([status])
  @@index([phone])
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
}

enum QuizKind {
  PLACEMENT
  WEEKLY
  LISTENING
}

enum ExamKind {
  MID
  FINAL
}

model ClassSession {
  id          String         @id @default(cuid())
  batchId     String
  heldOn      DateTime
  title       String
  notes       String?        @db.Text
  createdAt   DateTime       @default(now())
  batch       Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  attendance  Attendance[]

  @@index([batchId])
}

model Attendance {
  id         String             @id @default(cuid())
  sessionId  String
  studentId  String
  status     AttendanceStatus   @default(PRESENT)
  session    ClassSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student    Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model Quiz {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  kind        QuizKind
  courseId    String?
  weekId      String?
  published   Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  course      Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  week        CourseWeek?    @relation(fields: [weekId], references: [id], onDelete: SetNull)
  questions   QuizQuestion[]
  attempts    QuizAttempt[]

  @@index([kind])
}

model QuizQuestion {
  id        String @id @default(cuid())
  quizId    String
  prompt    String @db.Text
  choiceA   String
  choiceB   String
  choiceC   String
  choiceD   String
  correct   String
  sortOrder Int    @default(0)
  quiz      Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model QuizAttempt {
  id         String   @id @default(cuid())
  quizId     String
  studentId  String?
  name       String?
  phone      String?
  score      Int
  total      Int
  answers    Json?
  createdAt  DateTime @default(now())
  quiz       Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student    Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([quizId])
  @@index([studentId])
}

model OralExam {
  id        String           @id @default(cuid())
  batchId   String
  kind      ExamKind
  title     String
  heldOn    DateTime?
  createdAt DateTime         @default(now())
  batch     Batch            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  results   OralExamResult[]

  @@index([batchId])
}

model OralExamResult {
  id             String   @id @default(cuid())
  examId         String
  studentId      String
  pronunciation  Int
  vocabulary     Int
  fluency        Int
  understanding  Int
  passed         Boolean  @default(false)
  notes          String?  @db.Text
  exam           OralExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@index([studentId])
}

model HomeworkEntry {
  id        String     @id @default(cuid())
  weekId    String
  studentId String
  voiceUrl  String?    @db.Text
  notes     String?    @db.Text
  score     Int?
  createdAt DateTime   @default(now())
  week      CourseWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([weekId])
  @@index([studentId])
}

model Certificate {
  id         String   @id @default(cuid())
  code       String   @unique
  studentId  String
  courseName String
  issuedAt   DateTime @default(now())
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model PricingPackage {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  price            String
  period           String
  description      String
  features         Json
  cta              String
  whatsappMessage  String   @db.Text
  popular          Boolean  @default(false)
  published        Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model OnlineLevel {
  id               String   @id @default(cuid())
  slug             String   @unique
  level            String
  name             String
  badgeColor       String   @default("teal")
  monthlyPrice     String
  fullPrice        String
  features         Json
  whatsappMessage  String   @db.Text
  published        Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String   @db.Text
  answer    String   @db.Text
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  initial   String
  text      String   @db.Text
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorEmail String
  actorId    String?
  action     String
  entityType String
  entityId   String?
  summary    String   @db.Text
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  ip        String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}
